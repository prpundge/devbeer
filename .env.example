# Template for .env — copy this file to `.env` and fill in the value.
#
#     cp .env.example .env
#
# .env is gitignored. This template is tracked and must never contain a real token.

# JetBrains Marketplace publish token, used by `gradlew publishPlugin`.
# Generate one at https://plugins.jetbrains.com/author/me/tokens
JETBRAINS_PUBLISH_TOKEN=<paste-your-token-here>
